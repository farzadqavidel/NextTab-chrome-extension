{
  "manifest_version": 3,
  "name": "Tabyar",
  "version": "1.6.0",
  "key": "",
  "description": "Tabyar — Persian-first dashboard, tasks, focus timer and one-click bookmarks",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "tabs",
    "topSites"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://4kwallpapers.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "js/float-bookmark.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
