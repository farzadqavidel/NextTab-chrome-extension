{
  "manifest_version": 3,
  "name": "صفحه اول شخصی",
  "version": "1.1.0",
  "description": "صفحه اول گوگل با تقویم شمسی، بوکمارک‌های دلخواه، پوشه‌بندی و تنظیمات تم",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "bookmarks"],
  "host_permissions": [
    "https://api.open-meteo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
