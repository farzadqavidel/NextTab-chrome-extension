{
  "manifest_version": 3,
  "name": "NextTab",
  "version": "1.7.0",
  "key": "",
  "description": "NextTab — Persian-first dashboard, tasks, focus timer and one-click bookmarks",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "tabs",
    "topSites"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.priceto.day/*",
    "https://api.tgju.org/*",
    "https://call1.tgju.org/*",
    "https://www.zoomit.ir/*",
    "https://*.digiato.com/*",
    "https://www.varzesh3.com/*",
    "https://www.tejaratnews.com/*",
    "https://www.isna.ir/*",
    "https://www.mehrnews.com/*",
    "https://*.digikala.com/*",
    "https://feeds.bbci.co.uk/*",
    "https://api.rss2json.com/*",
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "js/float-bookmark.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}