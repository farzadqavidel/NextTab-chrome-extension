{
  "manifest_version": 3,
  "name": "Tabyar",
  "version": "1.4.0",
  "key": "",
  "description": "Tabyar — custom New Tab with Jalali calendar, bookmarks, and themes",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "bookmarks", "tabs"],
  "background": {
    "service_worker": "js/background.js"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://4kwallpapers.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
